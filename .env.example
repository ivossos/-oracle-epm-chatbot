# Runway project API key. Server-side only — never expose it to the browser.
# Create it in the Developer Portal: https://dev.runway.com/
RUNWAYML_API_SECRET=

# Which Character to use. Set RUNWAY_AVATAR_ID for your own Character
# (created in the Developer Portal). If empty, the preset below is used.
RUNWAY_AVATAR_ID=
RUNWAY_AVATAR_PRESET=human-resource

# Max length of one call, in seconds (sessions use project credits).
RUNWAY_MAX_DURATION=300
