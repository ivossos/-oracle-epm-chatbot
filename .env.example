# Copy to .env.local and fill in values from https://dashboard.workos.com
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORKOS_COOKIE_PASSWORD=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Oracle EPM Cloud. Leave EPM_URL empty to use built-in sample data.
EPM_URL=""                      # e.g. https://epm-yourco.epm.us-phoenix-1.ocs.oraclecloud.com
EPM_APPLICATION=""              # default application, e.g. Vision
EPM_USERNAME=""                 # classic pods: identitydomain.username
EPM_PASSWORD=""
# EPM_ACCESS_TOKEN=""           # OAuth token; used instead of username/password if set
